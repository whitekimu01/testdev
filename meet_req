## 2. Agent가 생성한 원본 코드 (Vibe Coding 산출물)

Agent가 위 명세를 보고 실시간으로 생성한 **아직 실행되지 않은 "설계도"**입니다.  
데이터는 없고, 구멍(`{{ }}`)만 뚫려 있습니다.

### `backend_logic.py` (템플릿)

```python
import requests
import pandas as pd
import json
from datetime import datetime, timedelta

# ========== Agent가 채워 넣은 파라미터 ==========
LOT_NO = "{{LOT_NO}}"
START_DATE = "{{START_DATE}}"
END_DATE = "{{END_DATE}}"
API_BASE = "{{API_BASE}}"  # 허용된 내부 API 주소
# =============================================

def fetch_data():
    url = f"{API_BASE}/api/v1/rma/kt1h/thickness"
    params = {
        "lot_no": LOT_NO,
        "start_date": START_DATE,
        "end_date": END_DATE
    }
    resp = requests.get(url, params=params, timeout=15)
    resp.raise_for_status()
    return resp.json()["data"]

def process(raw_list):
    df = pd.DataFrame(raw_list)
    
    # Pandas 전처리: 웨이퍼별 통계, Trend용 시계열 정렬
    df["measured_at"] = pd.to_datetime(df["measured_at"])
    df = df.sort_values(["wafer_id", "measured_at"])
    
    summary = df.groupby("wafer_id")["thickness"].agg(
        mean="mean", std="std", min="min", max="max"
    ).reset_index()
    
    return {
        "lot_no": LOT_NO,
        "raw": df.to_dict("records"),
        "summary": summary.to_dict("records"),
        "trend": df[["measured_at", "thickness", "wafer_id"]].to_dict("records")
    }

if __name__ == "__main__":
    raw = fetch_data()
    result = process(raw)
    with open("data.json", "w", encoding="utf-8") as f:
        json.dump(result, f, ensure_ascii=False, indent=2)
```

