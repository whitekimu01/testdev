# 2. 환경변수 주입 (Agent가 사용자 요청에서 뽑은 값)
os.environ["LOT_NO"] = "RMA20250801"
os.environ["API_BASE"] = "http://luma-back.internal"

# 3. [방법 A] backend_logic.py를 직접 실행 (가장 일반적)
result = subprocess.run(
    ["python", GENERATED_PY],
    capture_output=True, text=True, timeout=60
)

if result.returncode != 0:
    raise RuntimeError(f"코드 실행 실패: {result.stderr}")

# 4. 실행 결과물(data.json) 로드
with open("/workspace/data.json", "r") as f:
    analysis_data = json.load(f)

# 5. template.html의 {{JSON_DATA}}를 치환하여 최종 HTML 생성
with open(TEMPLATE_HTML, "r") as f:
    html = f.read()

final_html = html.replace("{{JSON_DATA}}", json.dumps(analysis_data, ensure_ascii=False))

with open("/workspace/final_report.html", "w") as f:
    f.write(final_html)

print("최종 페이지 완성: /workspace/final_report.html")
```

