배포시 자동 클론
1. 
mkdir -p ~/deploy-key && cd ~/deploy-key
# ① 생성 (전용 키 — 개인 id_ed25519 재사용 금지, 패스프레이즈 없음)
ssh-keygen -t ed25519 -f deploy_key -N ""
# ② 공개키 출력 → Bitbucket project-front Access keys에 read-only 등록
cat deploy_key.pub
# ③ 개인키를 base64 한 줄로 → 바로 클립보드에 복사 (Git Bash 기준)
base64 -w0 deploy_key | clip.exe
2. bitbucket에 public key 등록
3. deployment.yaml
spec:
      containers:
      - name: <container-name>
      ## 매뉴얼 생성용 프론트엔드 소스 clone
      - name: FRONTEND_REPO_URL
      value: "ssh://git@bitbucket.~.com:<port>/~.git"
      ## GIT_SSH_KEY_B64: 위 SSH 키 개인키의 base64 한 줄 값 (base64 -w0 <개인키파일>)
      - name: GIT_SSH_KEY_B64
      value: "LS0tL...FURSBLRVktLS0tLQo="
