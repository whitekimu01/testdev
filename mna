<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LUMA 화면 매뉴얼</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Segoe UI', 'Malgun Gothic', sans-serif; background: #f4f5fb; color: #2b2d42; min-height: 100vh; }
  .hero { background: linear-gradient(135deg, #4747b3 0%, #5c51b6 100%); color: #fff; padding: 36px 32px 30px; text-align: center; }
  .hero h1 { font-size: 26px; font-weight: 700; letter-spacing: .3px; }
  .hero p { margin-top: 8px; font-size: 13px; opacity: .85; }
  #q { margin-top: 18px; width: 100%; max-width: 520px; padding: 11px 16px; border: none; border-radius: 8px; font-size: 14px; outline: none; box-shadow: 0 2px 10px rgba(15,15,60,.18); }
  #list { max-width: 980px; margin: 26px auto 0; padding: 0 20px; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
  .card { display: block; background: #fff; border: 1px solid #e3e5f1; border-radius: 10px; padding: 15px 16px; text-decoration: none; color: inherit; transition: all .15s ease; }
  .card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(71,71,179,.15); border-color: #b9b6e6; }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .name { font-size: 15px; font-weight: 700; color: #3d3f9e; }
  .badge { font-size: 11px; font-weight: 600; padding: 2px 9px; border-radius: 999px; white-space: nowrap; }
  .b-chart { background: #e9e8fb; color: #4747b3; }
  .b-table { background: #e3f2ea; color: #1c7c54; }
  .b-real { background: #e3f2ea; color: #1c7c54; }
  .b-mock { background: #fdf3e0; color: #a4700f; }
  .b-render { background: #e3f2ea; color: #1c7c54; }
  .b-empty { background: #fdeaea; color: #b34747; }
  .b-struct { background: #dff3f6; color: #087f8c; }
  .top-badges { display: flex; gap: 5px; flex-shrink: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 9px; }
  .chip { font-size: 11px; background: #eef0fb; color: #5557bd; padding: 3px 8px; border-radius: 6px; font-family: Consolas, monospace; }
  .chip.ep { background: #f3f0ff; color: #6a4bc4; }
  .desc { margin-top: 9px; font-size: 12.5px; color: #777a94; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .gen-time { margin-top: 8px; font-size: 11px; color: #a7a9c0; }
  .no-data { grid-column: 1 / -1; text-align: center; color: #9a9cb5; padding: 48px 0; font-size: 14px; }
  #empty { display: none; max-width: 980px; margin: 18px auto 0; text-align: center; color: #9a9cb5; font-size: 14px; }
  footer { max-width: 980px; margin: 26px auto 40px; text-align: center; font-size: 12px; color: #9a9cb5; }
</style>
</head>
