### 3.5.3 Memory 처리 예시

Conversation Memory는 Redis 기반으로 관리하며 Agent 실행 Context를 유지합니다.

```python
from typing import Optional
from langgraph.checkpoint.redis import RedisSaver
from langgraph.checkpoint.memory import MemorySaver

# ==========================================
# 1. 환경별 Checkpointer 설정 (한 줄만 바꾸면 됨)
# ==========================================
try:
    # 프로덕션 환경: Redis 연결 객체를 넣어줍니다.
    # checkpointer = RedisSaver(conn=redis_connection)
    checkpointer = None  # 예시에서는 일단 비워둡니다.
except Exception:
    checkpointer = None

# 개발/테스트 환경: Redis 없이 메모리만 사용
if checkpointer is None:
    checkpointer = MemorySaver()


# ==========================================
# 2. 기존 함수와 동일한 인터페이스 (어댑터 역할)
# ==========================================
def save_memory(user_id: str, data: dict) -> None:
    """사용자별 대화 맥락을 저장합니다."""
    # thread_id에 user_id를 넣으면 사용자별로 구분됩니다.
    config = {"configurable": {"thread_id": user_id}}

    # Checkpointer가 이해하는 간단한 포맷
    checkpoint = {
        "channel_values": {"context": data}
    }

    # 저장 (내부적으로 Redis 또는 메모리에 기록)
    checkpointer.put(config, checkpoint, {},
{})


def load_memory(user_id: str) -> Optional[dict]:
    """사용자별 대화 맥락을 불러옵니다."""
    config = {"configurable": {"thread_id": user_id}}

    # 저장된 checkpoint 조회
    saved = checkpointer.get_tuple(config)
    if saved is None:
        return None

    # 실제 넣었던 데이터만 꺼내서 반환
    return saved.checkpoint.get("channel_values", {}).get("context")


# ==========================================
# 3. 사용 예시 (기존과 완전히 동일)
# ==========================================

# ---- 첫 번째 질문 ----
# [사용자] "Lot 관리 기능에 대해 알려줘"
# [Agent]  "Lot 관리는 생성, 조회, 수정 기능이 있습니다."

save_memory("user01", {
    "history": [
        {"role": "user",     "content": "Lot 관리 기능에 대해 알려줘"},
        {"role": "assistant", "content": "Lot 관리는 생성, 조회, 수정 기능이 있습니다."}
    ],
    "current_topic": "lot_management"
})


# ---- 두 번째 질문 ----
# [사용자] "그럼 생성은 어떻게 해?"
# 이 질문만 보면 "무슨 생성?" 이라고 되물어야 하지만,
# 이전 기억이 있으면 "Lot 생성"으로 알아들을 수 있음

past = load_memory("user01")  # ← 여기서 {current_topic: "lot_management", ...} 꺼냄

# Agent가 짧은 질문을 이해하는 순간
if past and past.get("current_topic") == "lot_management":
    answer = "Lot 생성은 [메뉴 → Lot → 생성]을 눌러서 진행합니다."
else:
    answer = "어떤 생성을 말씀하시는 건가요?"

# 대화를 이어서 저장 (다음 질문 대비)
history = past.get("history", [])
history.append({"role": "user",     "content": "그럼 생성은 어떻게 해?"})
history.append({"role": "assistant", "content": answer})

save_memory("user01", {
    "history": history,
    "current_topic": "lot_management"
})

print(context)
```

